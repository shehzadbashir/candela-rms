# Create .gitignore file with all rules
@"
# Dependencies
node_modules/
/.pnp
.pnp.js
.yarn/install-state.gz

# Build outputs
.next/
out/
build/
dist/
/.next/
/out/

# Environment files
.env
.env.local
.env.production
.env.development
.env.test
!.env.example

# Database
*.db
*.sqlite
prisma/*.db
prisma/*.sqlite

# Uploads
/backend/uploads/*
!/backend/uploads/.gitkeep

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS files
.DS_Store
Thumbs.db
desktop.ini

# IDE files
.vscode/
.idea/
*.swp
*.swo
*~

# Docker
docker-compose.override.yml
/nginx/ssl/*.pem
!/nginx/ssl/.gitkeep

# Backups
/database/backups/*
!/database/backups/.gitkeep

# Test coverage
coverage/
.nyc_output/

# Temporary files
tmp/
temp/
*.tmp

# Package lock files
!package-lock.json
!yarn.lock
"@ | Out-File -FilePath .gitignore -Encoding UTF8